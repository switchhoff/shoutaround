rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Rate limits — no client access at all ──────────────────────────────
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // ── Tabs ───────────────────────────────────────────────────────────────
    match /tabs/{tabId} {
      // Read: authenticated members only
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.rotationOrder;

      // Write: blocked — Cloud Functions only
      allow write: if false;

      // ── Rounds ───────────────────────────────────────────────────────────
      match /rounds/{roundId} {
        // Read: authenticated members of parent tab only
        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/tabs/$(tabId))
                    && request.auth.uid in get(/databases/$(database)/documents/tabs/$(tabId)).data.rotationOrder;

        // Write: blocked — Cloud Functions only
        allow write: if false;
      }
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
