{
  "expo": {
    "name": "Shout",
    "slug": "shout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C0F00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.getshout.shout"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C0F00"
      },
      "package": "app.getshout.shout",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-secure-store"
    ],
    "scheme": "shout",
    "extra": {
      "eas": {
        "projectId": "PLACEHOLDER"
      }
    }
  }
}
